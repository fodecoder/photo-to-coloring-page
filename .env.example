# Copy this file to `.env` and fill in real values if/when a setting below
# is used. Never commit a real `.env` file.

# Optional. Directory every ML engine looks in for its pretrained
# checkpoint, if the engine's own per-file variable below isn't set. If
# unset, defaults to ~/.cache/coloring_page. Lets a service deployment
# point every engine at one shared, pre-populated (e.g. read-only mounted)
# directory instead of setting one variable per engine.
# COLORING_PAGE_WEIGHTS_DIR=

# Optional. Only read by the `anime2sketch` engine (requires the `ml` extra,
# see pyproject.toml). Path to a manually downloaded Anime2Sketch pretrained
# weights file, overriding COLORING_PAGE_WEIGHTS_DIR for this engine only.
# If unset, defaults to $COLORING_PAGE_WEIGHTS_DIR/anime2sketch.pth (or
# ~/.cache/coloring_page/anime2sketch.pth). See the README's "Extending
# with an ML engine" section for where to download the weights from.
# COLORING_PAGE_ANIME2SKETCH_WEIGHTS=

# Optional. Only read by the `informative_drawings` engine (requires the
# `ml` extra, see pyproject.toml). Path to a manually downloaded
# Informative Drawings pretrained weights file (netG_A_latest.pth),
# overriding COLORING_PAGE_WEIGHTS_DIR for this engine only -- the only way
# to choose between the two available checkpoints (sk_model.pth vs
# sk_model2.pth), since both save under the same local filename. If unset,
# defaults to $COLORING_PAGE_WEIGHTS_DIR/informative_drawings.pth (or
# ~/.cache/coloring_page/informative_drawings.pth). See the README's
# "Extending with an ML engine" section for where to download the weights
# from.
# COLORING_PAGE_INFORMATIVE_DRAWINGS_WEIGHTS=

# Optional. Only read by the `lineart` engine (requires the `lineart`
# extra, see pyproject.toml). Path to a manually downloaded SAM 2.1
# Hiera-small checkpoint (sam2.1_hiera_small.pt), overriding
# COLORING_PAGE_WEIGHTS_DIR for this checkpoint only. If unset, defaults to
# $COLORING_PAGE_WEIGHTS_DIR/sam2.1_hiera_small.pt. See
# scripts/fetch_weights.py.
# COLORING_PAGE_LINEART_SEGMENTATION_WEIGHTS=

# Optional. Only read by the `lineart` engine (requires the `lineart`
# extra, see pyproject.toml). Path to a manually downloaded controlnet_aux
# lineart_anime detail-line checkpoint (netG.pth), overriding
# COLORING_PAGE_WEIGHTS_DIR for this checkpoint only. If unset, defaults to
# $COLORING_PAGE_WEIGHTS_DIR/netG.pth. See scripts/fetch_weights.py.
# COLORING_PAGE_LINEART_DETAIL_WEIGHTS=
