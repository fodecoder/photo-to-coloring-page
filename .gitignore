# Virtual environments
.venv/
venv/
env/
ENV/

# Byte-compiled / cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Distribution / packaging
build/
dist/
*.egg-info/
.eggs/
*.egg
pip-wheel-metadata/

# PyInstaller
*.spec
!packaging/*.spec

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Environment variables
.env

# IDE
.vscode/
.idea/
*.iml

# OS
.DS_Store
Thumbs.db

# Local reference/sample images (e.g. copyrighted source material used for
# manual testing) -- never intended for version control.
/docs/*.jpg
/docs/*.jpeg
/docs/*.png
/output.png
/*-output.png

# Downloaded ML model weights -- never bundled in the repository.
/weights/
